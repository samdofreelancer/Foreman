{
  "name": "foreman",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "foreman": "./dist/server/cli.js"
  },
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "dev": "npm run build:client && tsx src/server/cli.ts",
    "build": "npm run build:client && npm run build:server && npm run build:plugin-reference",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "tsup src/server/cli.ts --format esm --platform node --target node22 --out-dir dist/server --clean",
    "build:plugin-reference": "vite build --config vite.plugin.config.ts",
    "start": "node dist/server/cli.js",
    "watch": "vite build --config vite.plugin.config.ts --watch",
    "test": "vitest",
    "test:architecture": "vitest run tests/architecture-boundaries.test.ts",
    "check:architecture": "npm run typecheck && npm run test:architecture",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "11.0.0",
    "@opencode/client": "2.4.2",
    "@opencode/plugin": "^2.0.4",
    "better-sqlite3": "12.8.0",
    "effect": "^4.1.0",
    "fastify": "5.12.8",
    "open": "11.0.4",
    "solid-js": "^1.9.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.7",
    "vite": "^7",
    "vite-plugin-solid": "^2.11",
    "vitest": "^3"
  }
}
