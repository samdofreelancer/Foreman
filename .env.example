# The exact HTTPS origin configured in Tailscale Serve. Keep empty for local-only access.
FOREMAN_TRUSTED_HTTPS_ORIGIN=https://your-device.your-tailnet.ts.net:8443

# Host-only port. Docker Compose publishes this on 127.0.0.1, never on all interfaces.
FOREMAN_PORT=4318
FOREMAN_BIND_ADDRESS=127.0.0.1
FOREMAN_WINDOWS_HOST=host-gateway
FOREMAN_HOST_AGENT_TOKEN=replace-with-at-least-64-hex-characters
